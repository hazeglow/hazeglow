{
  "name": "hazeglow",
  "version": "0.6.0",
  "description": "Animated, grainy gradient backgrounds and mesh gradients for React. WebGL2, zero dependencies.",
  "keywords": [
    "react",
    "gradient",
    "mesh-gradient",
    "background",
    "webgl",
    "webgl2",
    "shader",
    "grain",
    "noise",
    "animated-gradient",
    "gradient-background",
    "gradient-generator",
    "mesh-gradient-react",
    "grainy-gradient",
    "dither",
    "ascii",
    "halftone",
    "stripe-gradient",
    "nextjs",
    "hero",
    "background-animation"
  ],
  "author": "Jakub Šalmík <som@jakubsalmik.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazeglow/hazeglow.git"
  },
  "homepage": "https://hazeglow.dev",
  "bugs": {
    "url": "https://github.com/hazeglow/hazeglow/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.3"
  }
}
